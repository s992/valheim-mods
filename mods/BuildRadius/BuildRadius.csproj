<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings, packages and game references: Directory.Build.props at the repo root -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Bigger build radius for workbenches, forges and every other crafting station: one multiplier plus optional per-station radii, set by the server in multiplayer. Needs Jotunn.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Jotunn syncs the admin-only settings from the server and checks versions when both sides have the mod. Also
      listed in thunderstore.toml. Only the DLL is used, for the reasons in docs/integrations.md.
    -->
    <PackageReference Include="JotunnLib" Version="2.30.2" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="Jotunn" HintPath="$(PkgJotunnLib)\lib\net462\Jotunn.dll" Private="false" />
  </ItemGroup>

</Project>
