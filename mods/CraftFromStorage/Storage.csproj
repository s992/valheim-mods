<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Storage</AssemblyName>
    <RootNamespace>Storage</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Craft, build, smelt and enchant from nearby chests. Works with Multi User Chest, Quick Stack Store Sort Trash Restock and Epic Loot.</Description>

    <!-- Generates MyPluginInfo (GUID/name/version) via BepInEx.PluginInfoProps -->
    <BepInExPluginGuid>s992.Storage</BepInExPluginGuid>
    <BepInExPluginName>Storage</BepInExPluginName>

    <!-- Needed by the publicizer so private game members can be used directly -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies are referenced from a local install and never committed -->
  <ItemGroup>
    <!-- Publicized, so private game members can be used directly (no reflection) -->
    <Reference Include="assembly_valheim" HintPath="$(ValheimManagedDir)\assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManagedDir)\assembly_utils.dll" Private="false" />
    <!-- Localization: any player-facing item/biome name goes through it -->
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ValheimManagedDir)\Splatform.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <!-- Status line (OnGUI) -->
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <!-- Requirement text ("have/need"); TMP_Text derives from a UnityEngine.UI type -->
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManagedDir)\UnityEngine.UI.dll" Private="false" />
    <!--
      Add as needed (CS0012 errors name the missing assembly):
      gui_framework                    GuiInputField (Terminal.m_input)
      UnityEngine.PhysicsModule         Physics, Collider, Rigidbody
      UnityEngine.IMGUIModule           OnGUI, GUI, GUIStyle
      UnityEngine.TextRenderingModule   Font, FontStyle (with IMGUI)
      UnityEngine.ParticleSystemModule  ParticleSystem
    -->
  </ItemGroup>

  <!-- Copy the build into the local mod profile for testing; skipped in CI -->
  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(CI)' != 'true' and Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)\$(AssemblyName)" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(PluginsDir)\$(AssemblyName)" />
  </Target>

</Project>
