<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings, packages and game references: Directory.Build.props at the repo root.
       assembly_valheim is publicized there: the support calculation it mirrors lives in private WearNTear members. -->
  <PropertyGroup>
    <Version>0.1.1</Version>
    <Description>Shows structure support values, where support comes from, and how changes affect it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

</Project>
