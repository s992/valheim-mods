<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings, packages and game references: Directory.Build.props at the repo root -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Search crafting recipes and chests, and find items in nearby chests with a quick-search window that marks where they are.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Localization: any player-facing item/biome name goes through it -->
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManagedDir)\assembly_guiutils.dll" Private="false" />
    <!-- GuiInputField: the build menu's search box, cloned for ours -->
    <Reference Include="gui_framework" HintPath="$(ValheimManagedDir)\gui_framework.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <!-- Reading our keys from every keyboard device, not only Keyboard.current -->
    <Reference Include="Unity.InputSystem" HintPath="$(ValheimManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

</Project>
