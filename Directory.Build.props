<Project>

  <!-- Machine-specific overrides (gitignored); see the properties below for what can be set -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Every build is as strict as CI: a warning fails it. Rule severities live in .editorconfig -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned (not "latest") so an SDK update can't add new warnings and break the build on its own -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Game assemblies target Unity's slightly newer System.* versions than netstandard2.1; harmless at runtime -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Paths. Each can be overridden in Directory.Build.user.props, with an environment variable
    of the same name, or on the command line (-p:ValheimDir=...).
  -->
  <PropertyGroup>
    <!-- Game install (client or dedicated server); provides the game and Unity assemblies -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == '' and Exists('$(ValheimDir)\valheim_Data\Managed')">$(ValheimDir)\valheim_Data\Managed</ValheimManagedDir>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">$(ValheimDir)\valheim_server_Data\Managed</ValheimManagedDir>

    <!-- Where builds are copied for local testing (r2modman profile by default) -->
    <PluginsDir Condition="'$(PluginsDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx\plugins</PluginsDir>
  </PropertyGroup>

  <!--
    Every project under mods/ is a BepInEx plugin named after its folder: mods/<Name>/<Name>.csproj builds
    <Name>.dll with GUID s992.<Name>. A mod's csproj only sets <Version>, <Description> and any extra references.
    tests/ (IsTestProject, set in tests/Directory.Build.props) shares the settings and game references, minus the
    plugin-only parts.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>

    <!-- Generates MyPluginInfo (GUID/name/version) via BepInEx.PluginInfoProps -->
    <BepInExPluginGuid>s992.$(MSBuildProjectName)</BepInExPluginGuid>
    <BepInExPluginName>$(MSBuildProjectName)</BepInExPluginName>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The game, Unity and BepInEx are all in the player's install; a mod ships only its own DLL -->
    <GameReferencesCopyLocal>false</GameReferencesCopyLocal>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Needed by the publicizer so private game members can be used directly -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <InternalsVisibleTo Include="ValheimMods.Tests" />
    <!--
      Shared source (shared/), compiled into every mod as internal types. Source rather than a shared DLL, so mods
      released at different times never fight over one assembly's version.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- Unity-specific checks (e.g. ?. and ?? on Unity objects skip Unity's destroyed-object check) -->
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.28.0" PrivateAssets="all" />
    <!-- APIs that bypass shared/ (Harmony's PatchAll, legacy input, Unity's log) are build errors: BannedSymbols.txt -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Game assemblies are referenced from a local install and never committed -->
  <ItemGroup>
    <!-- Publicized, so private game members can be used directly (no reflection) -->
    <Reference Include="assembly_valheim" HintPath="$(ValheimManagedDir)\assembly_valheim.dll" Private="$(GameReferencesCopyLocal)" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManagedDir)\assembly_utils.dll" Private="$(GameReferencesCopyLocal)" />
    <Reference Include="Splatform" HintPath="$(ValheimManagedDir)\Splatform.dll" Private="$(GameReferencesCopyLocal)" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManagedDir)\UnityEngine.dll" Private="$(GameReferencesCopyLocal)" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManagedDir)\UnityEngine.CoreModule.dll" Private="$(GameReferencesCopyLocal)" />
    <!--
      Add others in the mod's csproj as needed (CS0012 errors name the missing assembly):
      assembly_guiutils                 Localization (player-facing item/biome names)
      gui_framework                     GuiInputField (Terminal.m_input)
      UnityEngine.UI, Unity.TextMeshPro Image, TextMeshProUGUI, TMP_Text
      Unity.InputSystem                 checking keys against the game's bindings
      UnityEngine.PhysicsModule         Physics, Collider, Rigidbody
      UnityEngine.IMGUIModule           OnGUI, GUI, GUIStyle
      UnityEngine.TextRenderingModule   Font, FontStyle (with IMGUI)
      UnityEngine.ParticleSystemModule  ParticleSystem
    -->
  </ItemGroup>

</Project>
